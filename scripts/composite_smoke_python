#!/usr/bin/env bash
set -euo pipefail

test "$#" -eq 7
test "$*" = '-P -m yaga --gate codex-review --operation invalidate'
test "${GITHUB_TOKEN:-}" = not-used
test "${PYTHONSAFEPATH:-}" = 1
test "$(realpath -- "${PYTHONPATH:-}")" = "$(realpath -- "$GITHUB_WORKSPACE/src")"
test "${YAGA_GATE:-}" = codex-review
test "${YAGA_APPROVAL_MARKER+x}" = x
test -z "${YAGA_APPROVAL_MARKER:-}"
test "${YAGA_JOB_TIMEOUT_MINUTES:-}" = 15
test "${YAGA_LIFECYCLE_WORKFLOW:-}" = .github/workflows/review-policy.yml
test "${YAGA_OPERATION:-}" = invalidate
test "${YAGA_OWNER_ID:-}" = 15094983
test "${YAGA_PREREQUISITE_WORKFLOW:-}" = .github/workflows/ci.yml
test "${YAGA_REQUEST_TIMEOUT:-}" = 5
